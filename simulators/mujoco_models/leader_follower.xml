      <geom name="drone0_arm0" type="capsule" fromto="0 0 0.01 0.36 0.36 0.01" size="0.025" mass="0" material="arm_mat" contype="0" conaffinity="0"/>
      <geom name="drone0_arm1" type="capsule" fromto="0 0 0.01 -0.36 0.36 0.01" size="0.025" mass="0" material="arm_mat" contype="0" conaffinity="0"/>
      <geom name="drone0_arm2" type="capsule" fromto="0 0 0.01 -0.36 -0.36 0.01" size="0.025" mass="0" material="arm_mat" contype="0" conaffinity="0"/>
      <geom name="drone0_arm3" type="capsule" fromto="0 0 0.01 0.36 -0.36 0.01" size="0.025" mass="0" material="arm_mat" contype="0" conaffinity="0"/>

      <geom name="drone0_rotor0" type="cylinder" pos="0.36 0.36 0.035" size="0.13 0.008" mass="0" material="rotor_mat" contype="0" conaffinity="0"/>
      <geom name="drone0_rotor1" type="cylinder" pos="-0.36 0.36 0.035" size="0.13 0.008" mass="0" material="rotor_mat" contype="0" conaffinity="0"/>
      <geom name="drone0_rotor2" type="cylinder" pos="-0.36 -0.36 0.035" size="0.13 0.008" mass="0" material="rotor_mat" contype="0" conaffinity="0"/>
      <geom name="drone0_rotor3" type="cylinder" pos="0.36 -0.36 0.035" size="0.13 0.008" mass="0" material="rotor_mat" contype="0" conaffinity="0"/>
    </body>

    <!-- Recognizable X-frame quadrotor: follower -->
    <body name="drone1" pos="3.36 -0.27 1.0">
      <freejoint name="drone1_free"/>
      <geom name="drone1_body" type="box" size="0.16 0.11 0.055" mass="0.8" material="follower_mat"/>
      <geom name="drone1_hub" type="cylinder" pos="0 0 0.065" size="0.10 0.025" mass="0" material="hub_mat" contype="0" conaffinity="0"/>
