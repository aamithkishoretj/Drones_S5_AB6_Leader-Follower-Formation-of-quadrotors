      <geom name="drone1_rotor1" type="cylinder" pos="-0.36 0.36 0.035" size="0.13 0.008" mass="0" material="rotor_mat" contype="0" conaffinity="0"/>
      <geom name="drone1_rotor2" type="cylinder" pos="-0.36 -0.36 0.035" size="0.13 0.008" mass="0" material="rotor_mat" contype="0" conaffinity="0"/>
      <geom name="drone1_rotor3" type="cylinder" pos="0.36 -0.36 0.035" size="0.13 0.008" mass="0" material="rotor_mat" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
