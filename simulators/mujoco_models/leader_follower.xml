      <geom name="drone1_arm0" type="capsule" fromto="0 0 0.01 0.36 0.36 0.01" size="0.025" mass="0" material="arm_mat" contype="0" conaffinity="0"/>
      <geom name="drone1_arm1" type="capsule" fromto="0 0 0.01 -0.36 0.36 0.01" size="0.025" mass="0" material="arm_mat" contype="0" conaffinity="0"/>
